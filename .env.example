# --- Required -------------------------------------------------------------
# Your Anthropic API key (https://console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=
# Only needed for personal keys not scoped to a workspace (Console → Workspaces → copy the ID, starts with wrkspc_).
# ANTHROPIC_WORKSPACE_ID=

# --- Selling / access control ---------------------------------------------
# Comma-separated access codes. Give one to each paying customer (e.g. via
# Gumroad/Lemon Squeezy license keys or a Stripe Payment Link receipt).
# Leave empty ONLY for local development — otherwise anyone can spend your API credit.
ACCESS_CODES=
# Your own personal code as the owner: always works and has no hourly limit.
# Never give it to customers.
OWNER_CODE=
# Max generations per access code (or per IP when open) per hour.
RATE_LIMIT_PER_HOUR=40

# --- Branding & landing page ----------------------------------------------
NEXT_PUBLIC_APP_NAME=AutoTubeAI
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Prices in USD, numbers only. Annual default = ~28% off (about 3.5 months free).
NEXT_PUBLIC_PRICE_MONTHLY=29
NEXT_PUBLIC_PRICE_ANNUAL=249
# --- Paystack (Nigeria, Ghana, Kenya, South Africa, Côte d'Ivoire) --------
# When these are set, the pricing buttons open Paystack checkout and paying
# customers receive an access code automatically (it stops working if they cancel).
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PLAN_MONTHLY=PLN_...
# PAYSTACK_PLAN_ANNUAL=PLN_...
# Optional: currency symbol shown on the landing page (match your Paystack plans)
# NEXT_PUBLIC_CURRENCY_SYMBOL=$
# Optional: separate secret for signing paid access codes (defaults to one derived from the Paystack key).
# If you set it, never change it — changing it invalidates every customer's code.
# ACCESS_SIGNING_SECRET=

# Checkout links from Stripe Payment Links / Lemon Squeezy / Gumroad (one per plan)
NEXT_PUBLIC_CHECKOUT_URL_MONTHLY=https://your-monthly-checkout-link
NEXT_PUBLIC_CHECKOUT_URL_ANNUAL=https://your-annual-checkout-link
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_COMPANY_NAME=Your Company LLC

# --- Optional AI tuning ---------------------------------------------------
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium   # low | medium | high
