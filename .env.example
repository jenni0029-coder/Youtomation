# --- Required -------------------------------------------------------------
# Your Anthropic API key (https://console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=

# --- Selling / access control ---------------------------------------------
# Comma-separated access codes. Give one to each paying customer (e.g. via
# Gumroad/Lemon Squeezy license keys or a Stripe Payment Link receipt).
# Leave empty ONLY for local development — otherwise anyone can spend your API credit.
ACCESS_CODES=
# Max generations per access code (or per IP when open) per hour.
RATE_LIMIT_PER_HOUR=40

# --- Branding & landing page ----------------------------------------------
NEXT_PUBLIC_APP_NAME=AutoTubeAI
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CHECKOUT_URL=https://your-checkout-link
NEXT_PUBLIC_PRICE=$19
NEXT_PUBLIC_PRICE_NOTE=per month · cancel anytime
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_COMPANY_NAME=Your Company LLC

# --- Optional AI tuning ---------------------------------------------------
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium   # low | medium | high
